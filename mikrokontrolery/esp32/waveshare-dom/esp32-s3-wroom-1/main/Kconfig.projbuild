menu "Wi-Fi app configuration"

config WIFI_STA_SSID
    string "Wi-Fi SSID"
    default "SPIDERNET_114"
    help
        SSID of the access point used by station mode.

config WIFI_STA_PASSWORD
    string "Wi-Fi Password"
    default "1234554321"
    help
        Password of the access point used by station mode.
        Leave empty for an open network (no encryption).

endmenu

menu "DS18B20 (1-Wire)"

config DS18B20_GPIO_NUM
    int "DS18B20 data GPIO"
    default 4
    range 0 48
    help
        Data line to the sensor (VDD, GND, and typically 4.7k to 3.3 V).
        This project defaults to IO4; change if you use another pin.

endmenu
