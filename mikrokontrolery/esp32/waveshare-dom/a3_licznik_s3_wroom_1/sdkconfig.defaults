# Waveshare ESP32-S3-DEV-KIT-N8R8 (ESP32-S3-WROOM-1-N8R8)
# 8 MB Flash (Quad SPI) + 8 MB PSRAM (Octal)

CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_8mb.csv"

# PSRAM 8 MB (OPI octal na module WROOM-1-N8R8)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y

# Konsola na UART0 (CH343 na Waveshare) — 115200, port COM w PuTTY
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# WiFi + NTP (SSID/haslo: idf.py menuconfig -> A3 Cluster — siec i czas)
CONFIG_A3_WIFI_ENABLE=y
CONFIG_A3_NTP_SERVER="pool.ntp.org"
